{
  "name": "blog-admin",
  "version": "1.0.0",
  "description": "Blog admin management system",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider umi dev",
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider umi dev",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider umi build",
    "serve": "node server --title=blog-admin"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": "eslint --max-warnings=0 --ignore-pattern !.umirc*.js"
  },
  "dependencies": {
    "@ant-design/icons": "^2.1.0",
    "@babel/polyfill": "^7.6.0",
    "antd": "^3.22.2",
    "axios": "^0.19.0",
    "braft-editor": "^2.3.7",
    "classnames": "^2.2.6",
    "crypto-js": "^3.1.9-1",
    "echarts": "^4.2.1",
    "echarts-for-react": "^2.0.15-beta.0",
    "js-cookie": "^2.2.0",
    "lodash": "^4.17.11",
    "moment": "^2.24.0",
    "qs": "^6.7.0",
    "react-dnd": "7.0.2",
    "react-dnd-html5-backend": "7.0.2",
    "uuid": "^3.3.2"
  },
  "devDependencies": {
    "@types/braft-editor": "^1.9.3",
    "babel-eslint": "^9.0.0",
    "babel-plugin-import": "^1.12.0",
    "cross-env": "^10.1.0",
    "eslint": "^5.16.0",
    "eslint-config-prettier": "^4.3.0",
    "eslint-config-umi": "^1.5.0",
    "eslint-plugin-flowtype": "^2.50.3",
    "eslint-plugin-import": "^2.17.3",
    "eslint-plugin-jsx-a11y": "^6.2.1",
    "eslint-plugin-prettier": "^3.1.0",
    "eslint-plugin-react": "^7.13.0",
    "eslint-plugin-react-hooks": "^1.6.0",
    "husky": "^2.4.1",
    "less-vars-to-js": "^1.3.0",
    "lint-staged": "^8.2.0",
    "prettier": "^1.18.2",
    "redbox-react": "^1.6.0",
    "umi": "^2.9.6",
    "umi-plugin-react": "^1.10.1",
    "umi-types": "^0.4.1"
  }
}
